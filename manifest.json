{
  "manifest_version": 3,
  "name": "TabRescue",
  "version": "1.3",
  "description": "Preserves tabs, tab groups, and multiple windows when clearing history on exit.",
  "permissions": ["tabs", "storage", "sessions", "tabGroups"],
  "icons": {
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.svg",
    "default_title": "TabRescue"
  },
  "background": {
    "service_worker": "background.js"
  }
}